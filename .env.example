# Copy to .env (gitignored) and fill in ONE provider. The shell always wins.
#
# Mnemosyne's own brain proxy — nothing leaves the machine, no provider key here.
# The MnemoHermes cartridge shows this block.
MODEL_PROVIDER=mnemosyne
MNEMO_PROXY_KEY=
# MNEMO_PROXY_URL=http://127.0.0.1:7439/v1

# Or the Anthropic API directly:
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Or Amazon Bedrock (the default when MODEL_PROVIDER is unset): needs AWS
# credentials in the environment (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or
# AWS_PROFILE) and Bedrock model access in AWS_REGION.
# MODEL_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Or fully offline (needs Ollama running with the model pulled):
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL_ID=qwen3:8b
